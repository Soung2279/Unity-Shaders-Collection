  m_Script: {fileID: 11500000, guid: ae8dac3c1a202a84cb78673ac9e2c831, type: 3}
  m_Name: SpriteAtlasConfig
  m_EditorClassIdentifier: 
  autoScanRootDirs:
  - Assets/GameAsset/Sprite/Icon
