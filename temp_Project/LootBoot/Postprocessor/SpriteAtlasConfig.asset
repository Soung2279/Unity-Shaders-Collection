  autoImportWatchDirs:
  - Assets/GameAsset/Sprite
  pathMarker: Sprite
  packMode: 1
  directoryRules:
  - directoryPath: Assets/GameAsset/Sprite/Icon/Battle
    prefixes:
    - hero_
    - prop_
    - skill_
    excludeFiles: []
  - directoryPath: Assets/GameAsset/Sprite/Icon/Battle_weapon
    prefixes:
    - prop_bow_
    - skill_book_
    - skill_bow_
    - skill_club_
    - skill_spear_
    - skill_staff_
    - skill_sword_
    - prop_sword_
    excludeFiles: []
  - directoryPath: Assets/GameAsset/Sprite/Icon/Item
    prefixes:
    - icon_avatar_
    - icon_buff_
    - icon_hero_
    - icon_skill_
    - icon_wing_
    excludeFiles: []
  - directoryPath: Assets/GameAsset/Sprite/Icon/Monster
    prefixes:
    - monster
    - monster_boss
    - monster_elite
    excludeFiles: []
  minSpriteCount: 6
  enableAutoImport: 0
  autoFixTextureType: 1
  autoClearPackingTag: 1
  autoDisablePhysicsShape: 0
  autoSetAlphaIsTransparency: 1
  enableRotation: 0
  enableTightPacking: 0
  enableAlphaDilation: 0
  padding: 4
  readable: 0
  generateMipMaps: 0
  sRGB: 1
  filterMode: 1
